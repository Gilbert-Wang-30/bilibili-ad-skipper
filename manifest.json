{
  "manifest_version": 3,
  "name": "Bilibili Ad Skipper (恰饭跳过)",
  "version": "4.0.1",
  "description": "自动检测并跳过 B 站视频中的植入广告（恰饭）。基于 UP 主章节、众包标记（小电视空降助手）、字幕里的口播（随扩展安装的本地小模型，不调用 AI 服务）、弹幕（空降/感谢）、播放热度和音视频核验。另外把 B 站视频和直播的音量条改成听感均匀的曲线。",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.bilibili.com/*",
    "https://www.bilibili.com/*",
    "https://bvc.bilivideo.com/*",
    "https://bsbsb.top/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Bilibili Ad Skipper",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/*",
        "https://live.bilibili.com/*"
      ],
      "js": [
        "src/volume-curve.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.bilibili.com/*",
        "https://live.bilibili.com/*"
      ],
      "js": [
        "src/volume-settings.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.bilibili.com/video/*",
        "https://www.bilibili.com/*/video/*",
        "https://www.bilibili.com/list/*",
        "https://www.bilibili.com/*/list/*",
        "https://www.bilibili.com/festival/*",
        "https://www.bilibili.com/*/festival/*"
      ],
      "js": [
        "src/page-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.bilibili.com/video/*",
        "https://www.bilibili.com/*/video/*",
        "https://www.bilibili.com/list/*",
        "https://www.bilibili.com/*/list/*",
        "https://www.bilibili.com/festival/*",
        "https://www.bilibili.com/*/festival/*"
      ],
      "js": [
        "src/content/00-ns.js",
        "src/content/10-storage.js",
        "src/content/20-protobuf.js",
        "src/content/21-wbi.js",
        "src/content/22-api.js",
        "src/content/26-nn-line.js",
        "src/content/26-nn-model.js",
        "src/content/27-subtitle-model.js",
        "src/content/28-detect-subtitles.js",
        "src/content/29-media-features.js",
        "src/content/30-detect-chapters.js",
        "src/content/31-detect-danmaku.js",
        "src/content/32-media.js",
        "src/content/34-detect-heat.js",
        "src/content/35-skip-here.js",
        "src/content/36-media-probe.js",
        "src/content/37-av-segment.js",
        "src/content/39-detect-crowd.js",
        "src/content/33-fusion.js",
        "src/content/38-pipeline.js",
        "src/content/40-skipper.js",
        "src/content/41-ui.js",
        "src/content/50-main.js"
      ],
      "css": [
        "src/content/content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
